//@version=6
strategy("XAUUSD 15m — 1 Trade/Day: Sweep + Confirmation [Non-Repaint]", overlay = true, initial_capital = 10000, default_qty_type = strategy.fixed, default_qty_value = 1, pyramiding = 0, calc_on_every_tick = false, margin_long = 1, margin_short = 1, max_labels_count = 500)

tz = "Asia/Kolkata"

// ═════════════ INPUTS ═════════════
riskPct  = input.float(1.0, "Risk per Trade (% equity)", step = 0.1)
leverage = input.float(100, "Max Leverage (qty cap)", step = 10)
rr       = input.float(2.0, "Risk : Reward", step = 0.1)
slBuf    = input.float(0.2, "SL Buffer beyond Sweep Wick (ATR x)", step = 0.05)
maxSLatr = input.float(2.5, "Skip if SL > ATR x", step = 0.1)
confBars = input.int(2, "Confirmation Window after Sweep (bars)", minval = 0, maxval = 5)
trdSess  = input.session("1130-2230", "Trading Window (IST)")
eodSess  = input.session("2330-0530", "Close All (IST)")
asSess   = input.session("0530-1130", "Asian Range (IST)")
lonSess  = input.session("1130-1630", "London Range (IST)")

// ═════════════ HELPERS ═════════════
inS(int t, string s) =>
    int a = int(nz(str.tonumber(str.substring(s, 0, 4)), 0))
    int b = int(nz(str.tonumber(str.substring(s, 5, 9)), 2400))
    int x = hour(t, tz) * 100 + minute(t, tz)
    a <= b ? (x >= a and x < b) : (x >= a or x < b)

fmtHour(int h) =>
    h == 0 ? "12:00 AM" : h < 12 ? str.tostring(h) + ":00 AM" : h == 12 ? "12:00 PM" : str.tostring(h - 12) + ":00 PM"

h4Swings() =>
    float a = ta.pivothigh(high, 2, 2)
    float b = ta.pivotlow(low, 2, 2)
    [ta.valuewhen(not na(a), a, 0)[1], ta.valuewhen(not na(b), b, 0)[1]]

newIstDay = dayofmonth(time, tz) != dayofmonth(time[1], tz)
var int firstT    = na
var int tradeDays = 0
if na(firstT)
    firstT := time
dw = dayofweek(time, tz)
if (newIstDay or bar_index == 0) and dw != dayofweek.saturday and dw != dayofweek.sunday
    tradeDays += 1

// ═════════════ LEVELS (non-repaint) ═════════════
[wH, wL]   = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[dH, dL]   = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[s4H, s4L] = request.security(syminfo.tickerid, "240", h4Swings(), lookahead = barmerge.lookahead_on)

atr  = ta.atr(14)
rng  = high - low
tfMs = timeframe.in_seconds() * 1000

inAs  = inS(time, asSess)
inLon = inS(time, lonSess)

var float asH = na
var float asL = na
var float asHiF = na
var float asLoF = na
if inAs and not inAs[1]
    asH := high
    asL := low
    asHiF := na
    asLoF := na
else if inAs
    asH := math.max(asH, high)
    asL := math.min(asL, low)
if not inAs and inAs[1]
    asHiF := asH
    asLoF := asL

var float lnH = na
var float lnL = na
var float lnHiF = na
var float lnLoF = na
if inLon and not inLon[1]
    lnH := high
    lnL := low
    lnHiF := na
    lnLoF := na
else if inLon
    lnH := math.max(lnH, high)
    lnL := math.min(lnL, low)
if not inLon and inLon[1]
    lnHiF := lnH
    lnLoF := lnL

ph = ta.pivothigh(high, 3, 3)
pl = ta.pivotlow(low, 3, 3)
var float lastPH = na
var float lastPL = na
var float eqH = na
var float eqL = na
if not na(ph)
    if not na(lastPH) and math.abs(ph - lastPH) <= atr * 0.1
        eqH := math.max(ph, lastPH)
    lastPH := ph
if not na(pl)
    if not na(lastPL) and math.abs(pl - lastPL) <= atr * 0.1
        eqL := math.min(pl, lastPL)
    lastPL := pl
if not na(eqH) and close > eqH + atr
    eqH := na
if not na(eqL) and close < eqL - atr
    eqL := na

// 1 PWH/PWL, 2 PDH/PDL, 3 4H Swing, 4 Asian, 5 London, 6 Equal H/L
belowLv() => array.from(wL, dL, s4L, asLoF, lnLoF, eqL)
aboveLv() => array.from(wH, dH, s4H, asHiF, lnHiF, eqH)
lvName(int t) => t == 1 ? "PWH/PWL" : t == 2 ? "PDH/PDL" : t == 3 ? "4H Swing" : t == 4 ? "Asian H/L" : t == 5 ? "London H/L" : t == 6 ? "Equal H/L" : "-"

sweepInfo(array<float> lv, bool isLow) =>
    int   tp  = 0
    float sel = na
    for i = 0 to array.size(lv) - 1
        float l = array.get(lv, i)
        if tp == 0 and not na(l) and (isLow ? (low < l and close > l) : (high > l and close < l))
            tp  := i + 1
            sel := l
    [tp, sel]

[loT, loLv] = sweepInfo(belowLv(), true)
[hiT, hiLv] = sweepInfo(aboveLv(), false)

// ═════════════ SWEEP STATE ═════════════
var int   bBar = -1
var float bExt = na
var float bLvl = na
var int   bTyp = 0
var int   sBar = -1
var float sExt = na
var float sLvl = na
var int   sTyp = 0

if barstate.isconfirmed
    // cancel if price closes back beyond the swept level (real breakout, not a trap)
    if bBar >= 0 and bar_index > bBar and close < bLvl
        bBar := -1
    if sBar >= 0 and bar_index > sBar and close > sLvl
        sBar := -1
    // window expired
    if bBar >= 0 and bar_index - bBar > confBars
        bBar := -1
    if sBar >= 0 and bar_index - sBar > confBars
        sBar := -1
    // new sweep / deeper sweep inside window
    if loT > 0
        if bBar >= 0
            bExt := math.min(bExt, low)
        else
            bBar := bar_index
            bExt := low
            bLvl := loLv
            bTyp := loT
    if hiT > 0
        if sBar >= 0
            sExt := math.max(sExt, high)
        else
            sBar := bar_index
            sExt := high
            sLvl := hiLv
            sTyp := hiT

// ═════════════ CONFIRMATION CANDLES ═════════════
pinBull  = rng > 0 and (math.min(open, close) - low) >= rng * 0.5 and (close - low) >= rng * 0.6
pinBear  = rng > 0 and (high - math.max(open, close)) >= rng * 0.5 and (high - close) >= rng * 0.6
engBull  = close > open and close[1] < open[1] and close >= open[1] and open <= close[1]
engBear  = close < open and close[1] > open[1] and close <= open[1] and open >= close[1]

confL = barstate.isconfirmed and bBar >= 0 and (pinBull or engBull) and close > bLvl
confS = barstate.isconfirmed and sBar >= 0 and (pinBear or engBear) and close < sLvl

// ═════════════ ENTRY RULES ═════════════
var bool tradedToday = false
if newIstDay
    tradedToday := false

inWin  = inS(time, trdSess) and inS(time + tfMs, trdSess)
inEod  = inS(time, eodSess)
flat   = strategy.position_size == 0

slL = bExt - atr * slBuf
slS = sExt + atr * slBuf
rkL = close - slL
rkS = slS - close

goLong  = confL and inWin and flat and not tradedToday and rkL > 0 and rkL <= atr * maxSLatr
goShort = confS and inWin and flat and not tradedToday and rkS > 0 and rkS <= atr * maxSLatr and not goLong

calcQty(float risk) =>
    float qRisk = strategy.equity * riskPct / 100.0 / risk
    float qCap  = strategy.equity * leverage * 0.95 / close
    math.max(0.01, math.round(math.min(qRisk, qCap), 2))

var int curTyp = 0
var int curPat = 0
var int curHr  = 0

if goLong
    strategy.entry("L", strategy.long, qty = calcQty(rkL), comment = "BUY")
    strategy.exit("LX", "L", stop = slL, limit = close + rkL * rr)
    tradedToday := true
    curTyp := bTyp
    curPat := engBull ? 2 : 1
    curHr  := hour(time + tfMs, tz)
    label.new(bar_index, low - atr * 0.8, "BUY · " + lvName(bTyp) + " sweep\n" + (engBull ? "Engulfing" : "Pin Bar"), style = label.style_label_up, color = color.new(color.green, 0), textcolor = color.white, size = size.small)
    bBar := -1

if goShort
    strategy.entry("S", strategy.short, qty = calcQty(rkS), comment = "SELL")
    strategy.exit("SX", "S", stop = slS, limit = close - rkS * rr)
    tradedToday := true
    curTyp := sTyp
    curPat := engBear ? 2 : 1
    curHr  := hour(time + tfMs, tz)
    label.new(bar_index, high + atr * 0.8, "SELL · " + lvName(sTyp) + " sweep\n" + (engBear ? "Engulfing" : "Pin Bar"), style = label.style_label_down, color = color.new(color.red, 0), textcolor = color.white, size = size.small)
    sBar := -1

if inEod and not flat
    strategy.close_all(comment = "EOD Close")

// ═════════════ RESULT TRACKING ═════════════
var array<int> lvT  = array.new<int>(7, 0)
var array<int> lvW  = array.new<int>(7, 0)
var array<int> paT  = array.new<int>(3, 0)
var array<int> paW  = array.new<int>(3, 0)
var array<int> hrT  = array.new<int>(24, 0)
var array<int> hrW  = array.new<int>(24, 0)
var float npEntry = 0.0

bump(array<int> aT, array<int> aW, int i, int w) =>
    array.set(aT, i, array.get(aT, i) + 1)
    array.set(aW, i, array.get(aW, i) + w)

if strategy.position_size != 0 and strategy.position_size[1] == 0
    npEntry := strategy.netprofit[1]

if strategy.position_size == 0 and strategy.position_size[1] != 0
    int w = strategy.netprofit - npEntry > 0 ? 1 : 0
    bump(lvT, lvW, curTyp, w)
    bump(paT, paW, curPat, w)
    bump(hrT, hrW, curHr, w)

// ═════════════ VISUALS ═════════════
plot(wH, "PWH", color.new(color.purple, 0), 2, plot.style_stepline)
plot(wL, "PWL", color.new(color.purple, 0), 2, plot.style_stepline)
plot(dH, "PDH", color.new(color.fuchsia, 20), style = plot.style_stepline)
plot(dL, "PDL", color.new(color.fuchsia, 20), style = plot.style_stepline)
plot(s4H, "4H Swing High", color.new(color.blue, 20), 2, plot.style_stepline)
plot(s4L, "4H Swing Low", color.new(color.blue, 20), 2, plot.style_stepline)
plot(asHiF, "Asian High", color.new(color.orange, 20), style = plot.style_linebr)
plot(asLoF, "Asian Low", color.new(color.orange, 20), style = plot.style_linebr)
plot(lnHiF, "London High", color.new(color.aqua, 20), style = plot.style_linebr)
plot(lnLoF, "London Low", color.new(color.aqua, 20), style = plot.style_linebr)
plot(eqH, "Equal Highs", color.new(color.yellow, 0), style = plot.style_circles)
plot(eqL, "Equal Lows", color.new(color.yellow, 0), style = plot.style_circles)
bgcolor(inS(time, trdSess) ? color.new(color.blue, 95) : na, title = "Trading Window")

alertcondition(goLong, "BUY", "XAUUSD BUY — sweep + confirmation @ {{close}}")
alertcondition(goShort, "SELL", "XAUUSD SELL — sweep + confirmation @ {{close}}")

// ═════════════ TABLES ═════════════
beW = 100.0 / (1.0 + rr)
fWT(int w, int n) => n > 0 ? str.tostring(w) + "/" + str.tostring(n) + " (" + str.tostring(w * 100.0 / n, "#.#") + "%)" : "-"
cWT(int w, int n) => n == 0 ? color.gray : w * 100.0 / n >= beW + 5 ? color.lime : w * 100.0 / n >= beW ? color.yellow : color.red

drawTbl = barstate.islastconfirmedhistory or (barstate.isrealtime and barstate.isconfirmed)

var table tb = table.new(position.top_right, 2, 16, bgcolor = color.new(color.black, 20), border_width = 1)
row(int r, string a, string b, color c) =>
    table.cell(tb, 0, r, a, text_color = color.white, text_size = size.small)
    table.cell(tb, 1, r, b, text_color = c, text_size = size.small)

if drawTbl
    int   ct  = strategy.closedtrades
    float wr  = ct > 0 ? strategy.wintrades * 100.0 / ct : 0.0
    float pf  = strategy.grossloss > 0 ? strategy.grossprofit / strategy.grossloss : 0.0
    string per = str.format_time(firstT, "dd MMM", tz) + " – " + str.format_time(time, "dd MMM", tz)
    row(0, "XAUUSD 1 Trade/Day", "Sweep + Confirmation · 1:" + str.tostring(rr), color.yellow)
    row(1, "📅 Data", str.tostring(tradeDays) + " days · " + per, color.aqua)
    row(2, "Closed Trades", str.tostring(ct) + " (" + str.tostring(tradeDays > 0 ? ct * 1.0 / tradeDays : 0, "#.##") + "/day)", color.white)
    row(3, "Win Rate", str.tostring(wr, "#.##") + "%  (breakeven " + str.tostring(beW, "#.#") + "%)", ct == 0 ? color.gray : wr >= beW ? color.lime : color.red)
    row(4, "Profit Factor", str.tostring(pf, "#.##"), ct == 0 ? color.gray : pf >= 1.3 ? color.lime : pf >= 1 ? color.yellow : color.red)
    row(5, "Net Profit", str.tostring(strategy.netprofit, "#.##"), strategy.netprofit >= 0 ? color.lime : color.red)
    row(6, "Max Drawdown", str.tostring(strategy.max_drawdown, "#.##"), color.orange)
    row(7, "Pattern: Pin Bar", fWT(array.get(paW, 1), array.get(paT, 1)), cWT(array.get(paW, 1), array.get(paT, 1)))
    row(8, "Pattern: Engulfing", fWT(array.get(paW, 2), array.get(paT, 2)), cWT(array.get(paW, 2), array.get(paT, 2)))
    for i = 1 to 6
        row(8 + i, "Level: " + lvName(i), fWT(array.get(lvW, i), array.get(lvT, i)), cWT(array.get(lvW, i), array.get(lvT, i)))
    row(15, "TF", timeframe.period == "15" ? "15m OK" : timeframe.period + " → USE 15m", timeframe.period == "15" ? color.lime : color.orange)

var table ht = table.new(position.bottom_left, 2, 26, bgcolor = color.new(color.black, 25), border_width = 1)
if drawTbl
    table.cell(ht, 0, 0, "Hour (IST)", text_color = color.aqua, text_size = size.small)
    table.cell(ht, 1, 0, "W/T (WR)", text_color = color.aqua, text_size = size.small)
    int r = 1
    for h = 0 to 23
        int n = array.get(hrT, h)
        if n > 0
            table.cell(ht, 0, r, fmtHour(h), text_color = color.white, text_size = size.small)
            table.cell(ht, 1, r, fWT(array.get(hrW, h), n), text_color = cWT(array.get(hrW, h), n), text_size = size.small)
            r += 1
